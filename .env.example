# Public Firebase web configuration (safe to embed in the client bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase project. Use Application Default Credentials in production.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Production server
L9ITHA_HOST=127.0.0.1
L9ITHA_PORT=4173
L9ITHA_ALLOWED_ORIGIN=https://example.com
# Enable only behind a trusted reverse proxy that replaces X-Forwarded-For.
L9ITHA_TRUST_PROXY=0
